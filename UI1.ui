     <string notr="true">QWidget {
    background-image: url('Images/empty_horizontal_slider.png');
    background-repeat: no-repeat;
    background-position: center;
}

QSlider::groove:horizontal {
    background: #000000;
    height: 2px;  /* Was width bij vertical */
    border-radius: 4px;
}

